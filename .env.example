# ---- Database (PostgreSQL) ----
# Local dev: Homebrew postgresql@16 (createdb research_claw).
#   brew services start postgresql@16 && createdb research_claw
# Production: Supabase — DATABASE_URL = pooled (PgBouncer, port 6543),
#   DIRECT_DATABASE_URL = direct connection (port 5432, used by `prisma migrate`).
DATABASE_URL="postgresql://USER@localhost:5432/research_claw?schema=public"
DIRECT_DATABASE_URL="postgresql://USER@localhost:5432/research_claw?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# From Google Cloud Console -> Credentials -> OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Dev mock login ----
# When "true", a one-click "Sign in as Test User" login is enabled (no Google needed).
# MUST be "false" / unset in production.
ALLOW_DEV_LOGIN="true"
# Client-visible mirror of the above (controls whether the dev login button shows)
NEXT_PUBLIC_ALLOW_DEV_LOGIN="true"

# ---- File storage ----
# STORAGE_DRIVER: "local" (dev, filesystem) or "r2" (prod, Cloudflare R2).
STORAGE_DRIVER="local"
# Local filesystem storage (used when STORAGE_DRIVER=local).
UPLOAD_DIR="./storage/uploads"
# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES="26214400"
# Cloudflare R2 (used when STORAGE_DRIVER=r2). Endpoint is derived from
# R2_ACCOUNT_ID if R2_ENDPOINT is unset. Scope the API token to this one bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# ---- Claude (Part B/C chat) ----
# Chat is driven by the Claude Code CLI (`claude`). Each logged-in user
# authorizes their OWN Anthropic account in the UI ("Authorize Claude" →
# `claude auth login`); their session is stored under CLAUDE_AUTH_DIR.
# Resolution per chat:
#   1. account  — the user completed `claude auth login`
#   2. sharedKey — this optional owner ANTHROPIC_API_KEY (billed to you)
#   3. mock      — neither available
ANTHROPIC_API_KEY=""
# Model used for chat (CLI --model alias or full id).
CLAUDE_MODEL="claude-opus-4-8"
# Path to the claude CLI (defaults to "claude" on PATH).
CLAUDE_CLI_PATH="claude"
# Per-user Claude login config dirs.
CLAUDE_AUTH_DIR="./storage/claude-auth"
# Per-document Claude chat session working dirs (legacy; Agent SDK era).
CLAUDE_SESSIONS_DIR="./storage/claude-sessions"
# Force the mock (useful for tests): "true"|"false".
CLAUDE_FORCE_MOCK="false"
# Optional 32-byte base64 key for encrypting stored secrets (BYOK key).
# When unset, derived from AUTH_SECRET.
APP_ENCRYPTION_KEY=""
